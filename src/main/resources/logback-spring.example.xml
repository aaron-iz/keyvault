<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender (optional, keep logs in console) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                [%level] - %d{yyyy-MM-dd HH:mm:ss.SSS} %n
                logger: %logger %n
                method: %method %n
                exception: %ex %n
                body: %msg %n
                host: %X{host} %n
                httpMethod: %X{http_method} %n
                trace_id: %X{trace_id} %n
                success: %X{success} %n
                details: %X{details} %n
            </pattern>
        </encoder>
    </appender>

    <!-- Discord appender -->
    <appender name="DISCORD" class="nasa.keyvault.shared.logging.DiscordLogAppender">
        <webhookUri>https://discord.com/api/webhooks/YOUR_WEBHOOK</webhookUri>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DISCORD"/>
    </root>

</configuration>
